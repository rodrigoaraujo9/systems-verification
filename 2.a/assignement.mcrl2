sort
    sort Id = struct t1 | t2 | t3;

act
    t_approach, t_grant, t_enter, t_leave : Id;

    c_approach, c_grant, c_leave : Id;
    c_lower, c_raise;

    g_lower, g_raise;

    approach, grant, leave : Id;
    lower, raise;

proc
    Train(t: Id) =
        t_approach(t) . t_grant(t) . t_enter(t) . t_leave(t) . Train(t);

    Gate =
        g_lower . g_raise . Gate;

    CONTROLLER = % THINK!

init
    % THINK!
