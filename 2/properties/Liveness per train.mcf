% 5a: enter(t) remains reachable throughout the wait after approach(t).
% 5b: no other train enters twice during that wait.
% Eventual entry on every infinite execution additionally follows from the
% finite FIFO queue and the absence of an infinite cycle that avoids its head.
forall t, t': Id .
  ([true* . approach(t) . (!enter(t))*] <true* . enter(t)> true) &&
  (val(t != t') =>
    [true* . approach(t) . (!enter(t))* . enter(t') . (!enter(t))* . enter(t')] false)
