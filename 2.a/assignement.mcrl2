sort
  TrainId = struct t1 | t2 | t3;
  Gate    = struct open | closed;

act
    % Train Actions
    approach_train, grant_train, leave_train,
	enter, exit : TrainId;

    % Controller Actions
    lower_controller, down_controller, raise_controller, up_controller;
    approach_controller, grant_controller, leave_controller : TrainId;

    % Gate Actions
    lower_gate, down_gate, raise_gate, up_gate;

    % Communication Actions
    approach_comm, grant_comm, leave_comm : TrainId;
    lower_comm, down_comm, raise_comm, up_comm;

proc
  TRAIN(t: TrainId) = approach_train(t)
				    . grant_train(t)
				    . enter(t)
					. exit(t)
					. leave_train(t)
					. TRAIN(t);

  GATE(g: Gate) =
      (g == open)   -> lower_gate . down_gate . GATE(closed)
    + (g == closed) -> raise_gate . up_gate   . GATE(open);

  CONTROLLER(t: TrainId) =
      approach_controller(t)
    . lower_controller . down_controller
    . grant_controller(t)
    . leave_controller(t)
    . raise_controller . up_controller
    . CONTROLLER(t);

init
  hide( { lower_comm
        , down_comm
        , grant_comm
        , raise_comm
        , up_comm
        , approach_comm
        , leave_comm }
      , block( { lower_controller
               , lower_gate
               , grant_controller
               , grant_train }
			 , comm( { approach_train   | approach_controller -> approach_comm
                     , lower_controller | lower_gate          -> lower_comm
				     , down_controller  | down_gate           -> down_comm
					 , grant_train      | grant_controller    -> grant_comm
					 , leave_train      | leave_controller    -> leave_comm
					 , raise_controller | raise_gate          -> raise_comm
					 , up_controller    | up_gate             -> up_comm }
				   , TRAIN(t1) || TRAIN(t2) || TRAIN(t3) || GATE(open) || CONTROLLER(t1) )));
