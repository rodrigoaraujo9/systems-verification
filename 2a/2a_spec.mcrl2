sort
    Id = struct t1 | t2 | t3;
    Gate = struct open | closed;
    Crossing = struct busy | free;

act
    % Train Actions
    approach_train, grant_train, leave_train,
    enter, exit : Id;

    % Controller Actions
    lower_controller, down_controller, raise_controller, up_controller;
    approach_controller, grant_controller, leave_controller : Id;

    % Gate Actions
    lower_gate, down_gate, raise_gate, up_gate;

    % Communication Actions
    approach, grant, leave : Id;
    lower, down, raise, up;

proc
    TRAIN(t: Id) = approach_train(t)
                 . grant_train(t)
                 . enter(t)
                 . exit(t)
                 . leave_train(t)
                 . TRAIN(t);

    GATE = lower_gate . down_gate . raise_gate . up_gate . GATE;

    CONTROLLER(trains: FSet(Id), crossing: Crossing, gate: Gate) =

        (sum t: Id . !(t in trains) ->
            approach_controller(t) . CONTROLLER(trains + {t}, crossing, gate)) +

        ((gate == open && trains != {}) ->
            lower_controller . down_controller . CONTROLLER(trains, crossing, closed)) +

        (sum t: Id . (t in trains && gate == closed && crossing == free) ->
            grant_controller(t) . CONTROLLER(trains, busy, gate)) +

        (sum t: Id . (t in trains && crossing == busy) ->
            leave_controller(t) . CONTROLLER(trains - {t}, free, gate)) +

        ((gate == closed && trains == {}) ->
            raise_controller . up_controller . CONTROLLER(trains, crossing, open));

init
    allow({ approach, lower, down, grant, leave, raise, up, enter, exit },
        comm( { approach_controller | approach_train -> approach
              , lower_controller    | lower_gate     -> lower
              , down_controller     | down_gate      -> down
              , grant_controller    | grant_train    -> grant
              , leave_controller    | leave_train    -> leave
              , raise_controller    | raise_gate     -> raise
              , up_controller       | up_gate        -> up }
            , TRAIN(t1) || TRAIN(t2) || TRAIN(t3) || GATE || CONTROLLER({}, free, open)));
