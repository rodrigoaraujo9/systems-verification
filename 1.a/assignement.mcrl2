sort
  Gate = struct open | closed;

act
  	% Train Actions
   	approach_train, grant_train, leave_train;

    % Controller Actions
  	approach_controller, lower_controller, down_controller,
  	grant_controller, leave_controller, raise_controller, up_controller;

	% Gate Actions
  	lower_gate, down_gate, raise_gate, up_gate;

    % Communication Actions
  	approach_comm, lower_comm, down_comm, grant_comm,
  	leave_comm, raise_comm, up_comm;

    % Controller Actions
  	enter, exit;

proc
  TRAIN = approach_train . grant_train . enter . exit . leave_train . TRAIN;

  GATE(g: Gate) =
      (g == open)   -> lower_gate . down_gate . GATE(closed)
    + (g == closed) -> raise_gate . up_gate   . GATE(open);

  CONTROLLER =
      approach_controller
    . lower_controller . down_controller
    . grant_controller
    . leave_controller
    . raise_controller . up_controller
    . CONTROLLER;

init
  hide( { lower_comm
	    , down_comm
	    , grant_comm
	    , raise_comm
        , up_comm
		, approach_comm
		, leave_comm }
	  , block( { lower_controller
			   , lower_gate
			   , grant_controller
			   , grant_train }, comm( { approach_train   | approach_controller -> approach_comm
                     				  , lower_controller | lower_gate          -> lower_comm
                     				  , down_controller  | down_gate           -> down_comm
                     				  , grant_train      | grant_controller    -> grant_comm
                     				  , leave_train      | leave_controller    -> leave_comm
                     				  , raise_controller | raise_gate          -> raise_comm
                     				  , up_controller    | up_gate             -> up_comm }
                   					, TRAIN || GATE(open) || CONTROLLER )));
